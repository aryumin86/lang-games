@page "/crossword"
@using Crosswords.Common.Entities
@using Crosswords.Common.Repositories
@using CrosswordsWA.Models.Crossword

<PageTitle>Crossword</PageTitle>

<div class="container">
    <h3>
        <span class="badge bg-secondary">
            Game status: @gameStage
        </span>
    </h3>
    <div class="row pb-2">
        <div class="col-auto">
            <div class="flex-row input-group options-container">
                <button disabled="@restartButtonIsDisabled" class="btn btn-primary" @onclick="RestartButtonClicked">@restartButtonTitle</button>
                <select @bind="crosswordSize" class="form-select w-auto" aria-label="Select size">
                    <option selected>Select size</option>
                    <option value="10">10x10</option>
                    <option value="15">15x15</option>
                    <option value="20">20x20</option>
                    <option value="25">25x25</option>
                    <option value="30">30x30</option>
                </select>
                <select @bind="translationMode" class="form-select w-auto" aria-label="Translation mode">
                    <option selected>Translation mode</option>
                    <option value="1">Word</option>
                    <option value="2">Definition</option>
                </select>
                <select @bind="selectedWordsLanguageId" class="form-select w-auto" aria-label="Words language">
                    <option value="" selected>Words language</option>
                    @foreach (var lang in allLanguages.Where(l => l.Id != 3)) // not chinese
                    {
                        <option value="@lang.Id">@lang.Name</option>
                    }
                </select>
                <select @bind="selectedWordsTranslationLanguageId" class="form-select w-auto" aria-label="Translation language">
                    <option value="" selected>Translation language</option>
                    @foreach (var lang in allLanguages)
                    {
                        <option value="@lang.Id">@lang.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm col-12">

            @for(var r = 0; r < charCells.Length; r++)
            {
                <div class="row">
                    <div class="col-sm col-9">
                        <div class="cross-row">
                        @foreach(var charCell in charCells[r])
                        {
                                <div class="cross-cell @(charCell.ContainsLetter ? "contains-letter-cell" : "contains-no-letter-cell")">
                                    @if (charCell.WordStart)
                                    {
                                        @charCell.WordNumberInList
                                    }
                                </div>
                        }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Inject] private ILanguagesRepository? languagesRepository { get; set; }
    [Inject] private IWordsRepository? wordsRepository { get; set; }

    enum GameStage
    {
        NOT_STARTED = 1,
        IN_PROCESS = 2,
        FINISHED = 3
    }

    private string restartButtonTitle = "Start new game";
    private GameStage gameStage = GameStage.NOT_STARTED;
    private CharCell[][] charCells = new CharCell[0][];
    private bool restartButtonIsDisabled =>
        string.IsNullOrWhiteSpace(selectedWordsLanguageId) ||
        string.IsNullOrWhiteSpace(selectedWordsTranslationLanguageId);
    private IEnumerable<Language> allLanguages = Array.Empty<Language>();

    private string? selectedWordsLanguageId = "null";
    private string? selectedWordsTranslationLanguageId = null;
    private string? crosswordSize = null;
    private string? translationMode = null;

    private Dictionary<int, UsedWordInfo> usedWords = null;

    protected override void OnInitialized()
    {
        allLanguages = languagesRepository.GetLanguages(_ => true).ToList();
        selectedWordsLanguageId = "1";
        selectedWordsTranslationLanguageId = "2";
        crosswordSize = "15";
        translationMode = "1";

        base.OnInitialized();
    }

    private void ShowOptionsClicked()
    {

    }

    private void RestartButtonClicked()
    {
        switch (gameStage)
        {
            case GameStage.NOT_STARTED:
                restartButtonTitle = "Game started!";
                charCells = GetWordsForCrossword();
                gameStage = GameStage.IN_PROCESS;
                break;
            case GameStage.IN_PROCESS:
                restartButtonTitle = "Game finished!";
                gameStage = GameStage.FINISHED;
                break;
            case GameStage.FINISHED:
                restartButtonTitle = "Start new game!";
                gameStage = GameStage.NOT_STARTED;
                charCells = new CharCell[0][];
                break;
        }
    }

    private enum WordDirection
    {
        Horizontal = 1, 
        Vertical = 2
    }

    private class UsedWordInfo
    {
        public Word Word { get; set; }
        public WordDirection WordDirection { get; set; }
        public (int X, int Y) StartPosition { get; set; }
        public (int X, int Y) EndPosition { get; set; }
        public IList<(int X, int Y, char Letter)> CrossedLetters { get; set; } = new List<(int X, int Y, char Letter)>();
    }

    private CharCell[][] GetWordsForCrossword()
    {
        var size = int.Parse(crosswordSize);
        var res = new CharCell[size][];
        var allWords = wordsRepository.GetWords(w => w.LanguageId == int.Parse(selectedWordsLanguageId)).ToList();

        var words = allWords.OrderBy(_ => new Guid()).ToArray(); // shuffle of list
        usedWords = new Dictionary<int, UsedWordInfo>();

        for (int allWordsIndex = 0; allWordsIndex < words.Length; allWordsIndex++)
        {
            var currentWord = words[allWordsIndex];
            var currentWordLetters = currentWord.WordStr.ToCharArray();

            // TODO add main circle break if no varients found

            // TODO add break if max words were already added

            if (!usedWords.Any())
            {
                LocateFirstWord(currentWord);
            }

            // if (usedWords.ContainsKey(words[allWordsIndex].Id)) continue;

            // looking for another located word that contains any of the current word's letters.
            // this letter shold not be already in use of another word (words corossing)
            for (int pairWordIndex = 0; pairWordIndex < allWords.Count(); pairWordIndex++)
            {
                if (usedWords.ContainsKey(words[pairWordIndex].Id)) continue;

                var pairWord = allWords[pairWordIndex];
                var pairWordLetters = pairWord.WordStr.ToCharArray();

                if (currentWord.Id == pairWord.Id) continue;
                for (int currentWordLetterIndex = 0; currentWordLetterIndex < currentWordLetters.Length; currentWordLetterIndex++)
                {
                    for (int pairWordLetterIndex = 0; pairWordLetterIndex < pairWordLetters.Length; pairWordLetterIndex++)
                    {
                        if (currentWordLetters[currentWordLetterIndex] == pairWordLetters[pairWordLetterIndex] 
                            && !usedWords.ContainsKey(pairWord.Id)
                            && !LetterIsCrossedByAnotherWord(currentWord, currentWordLetterIndex) 
                            && !LetterIsCrossedByAnotherWord(pairWord, pairWordLetterIndex) // may be there is no need to check it
                            && WordCanBeLocatedHere(currentWord, pairWord, currentWordLetterIndex, pairWordLetterIndex))
                        {
                            LocateWord(currentWord, pairWord, currentWordLetterIndex, pairWordLetterIndex);
                            break;
                        }
                    }
                }
            }
        }

        ////////////////////////////////////////////////////
        // int fakeWordLastNumber = 0;
        // for (int i = 0; i <= size - 1; i++)
        // {
        //     res[i] = new CharCell[size];
        //     for (var j = 0; j <= size - 1; j++)
        //     {
        //         var wordStart = new Random().Next(16) == 5;
        //         if (wordStart){
        //             fakeWordLastNumber++;
        //         }
        //         var containsChar = new Random().Next(4) == 3;
        //         res[i][j] = new CharCell
        //         {
        //             RealLetter = (char)i,
        //             WordStart = wordStart,
        //             WordNumberInList = wordStart ? fakeWordLastNumber : null,
        //             ContainsLetter = wordStart || containsChar
        //         };
        //     }
        // }

        var wordNumberInList = 1;
        for(int i = 0; i < size; i++)
        {
            res[i] = new CharCell[size];
            //todo add empty (black) cells here too
            for(int j = 0; j < size; j++)
            {
                
            }
        }

        foreach(var word in usedWords.Select(x => x.Value))
        {
            if(word.WordDirection == WordDirection.Horizontal)
            {
                var wordStart = true;
                for(int i = word.StartPosition.X; i < word.EndPosition.X; i++)
                {
                    var charCell = new CharCell
                    {
                        ContainsLetter = true,
                        WordStart = wordStart,
                            RealLetter = word.Word.WordStr.ToCharArray()[i - word.StartPosition.X],
                        WordNumberInList = wordNumberInList++
                    };
                    wordStart = false;
                    res[word.StartPosition.X+i][word.StartPosition.Y] = charCell;
                }
            }
            else
            {
                var wordStart = true;
                for (int i = word.StartPosition.Y; i < word.EndPosition.Y; i++)
                {
                    var charCell = new CharCell
                        {
                            ContainsLetter = true,
                            WordStart = wordStart,
                            RealLetter = word.Word.WordStr.ToCharArray()[i - word.StartPosition.Y],
                            WordNumberInList = wordNumberInList++
                        };
                    wordStart = false;
                    res[word.StartPosition.X][word.StartPosition.Y+i] = charCell;
                }
            }
        }

        return res;
    }

    private void LocateFirstWord(Word word)
    {
        var wordDirection = new Random().Next(1, 2) == 1 ? WordDirection.Horizontal : WordDirection.Vertical;
        var xAndStartPosition = int.Parse(crosswordSize) - word.WordStr.Length / 2;
        var wInfo = new UsedWordInfo
        {
            Word = word,
                StartPosition = (xAndStartPosition, xAndStartPosition),
                EndPosition = wordDirection == WordDirection.Horizontal 
                            ? (xAndStartPosition + word.WordStr.Length, xAndStartPosition) 
                            : (xAndStartPosition, xAndStartPosition + word.WordStr.Length),
            WordDirection = wordDirection
        };
        usedWords.Add(word.Id, wInfo);
    }

    private void LocateWord(Word currentWord, Word pairWord, int currentWordLetterIndex, int pairWordLetterIndex)
    {
        var current = usedWords[currentWord.Id];
        var pairInfo = new UsedWordInfo
        {
                StartPosition = current.WordDirection == WordDirection.Horizontal 
                    ? (current.StartPosition.X + currentWordLetterIndex, current.StartPosition.Y - pairWordLetterIndex)
                    : (current.StartPosition.X - pairWordLetterIndex, current.StartPosition.Y + currentWordLetterIndex),
                Word = pairWord,
                WordDirection = current.WordDirection == WordDirection.Horizontal 
                    ? WordDirection.Vertical
                    : WordDirection.Horizontal
        };

        var pairWordLetters = pairWord.WordStr.ToCharArray();
        pairInfo.EndPosition = pairInfo.WordDirection == WordDirection.Horizontal
            ? (pairInfo.StartPosition.X + pairWordLetters.Length, pairInfo.StartPosition.Y)
            : (pairInfo.StartPosition.X, pairInfo.StartPosition.Y + pairWordLetters.Length);

        List<(int X, int Y, char Letter)> pairWordLettersWithCoordinates = new List<(int X, int Y, char Letter)>();
        for (int i = 0; i < pairWordLetters.Length; i++)
        {
            if (current.WordDirection == WordDirection.Horizontal)
                pairWordLettersWithCoordinates.Add((pairInfo.StartPosition.X, pairInfo.StartPosition.Y + i, pairWordLetters[i]));
            else
                pairWordLettersWithCoordinates.Add((pairInfo.StartPosition.X + i, pairInfo.StartPosition.Y, pairWordLetters[i]));
        }
        foreach(var crossedLetterCoord in usedWords.Values.SelectMany(w => w.CrossedLetters))
        {
            if (pairWordLettersWithCoordinates.Any(pwc => pwc.X == crossedLetterCoord.X && pwc.Y == crossedLetterCoord.Y)){
                pairInfo.CrossedLetters.Add(crossedLetterCoord);
            }
        }

        usedWords.Add(pairInfo.Word.Id, pairInfo);
    }

    private bool LetterIsCrossedByAnotherWord(
        Word word, int letterIndex)
    {
        if (!usedWords.ContainsKey(word.Id)) return false;
        var currentUsedWord = usedWords[word.Id];
        var letter = word.WordStr.ToCharArray()[letterIndex];
        (int X, int Y, char Letter) letterCoordinates = currentUsedWord.WordDirection == WordDirection.Horizontal
            ? (currentUsedWord.StartPosition.X + letterIndex, currentUsedWord.StartPosition.Y, letter)
            : (currentUsedWord.StartPosition.X, currentUsedWord.StartPosition.Y + letterIndex, letter);

        return currentUsedWord.CrossedLetters.Any(l => l == letterCoordinates);
    }

    private bool WordCanBeLocatedHere(
        Word currentWord, Word pairWord, int currentWordLetterIndex, int pairWordLetterIndex)
    {
        //var currentUsedWord = usedWords[currentWord.Id];
        var currentUsedWord = usedWords[currentWord.Id];
        (int X, int Y) letterCoordinates = currentUsedWord.WordDirection == WordDirection.Horizontal
            ? (currentUsedWord.StartPosition.X + currentWordLetterIndex, currentUsedWord.StartPosition.Y)
            : (currentUsedWord.StartPosition.X, currentUsedWord.StartPosition.Y + currentWordLetterIndex);

        (int X, int Y) pairWordStartCoordinates = currentUsedWord.WordDirection == WordDirection.Horizontal // pair word has opposite direction to current word
            ? (letterCoordinates.X, letterCoordinates.Y - pairWordLetterIndex)
            : (letterCoordinates.X - pairWordLetterIndex, letterCoordinates.Y);

        (int X, int Y) pairWordEndCoordinates = currentUsedWord.WordDirection == WordDirection.Horizontal // pair word has opposite direction to current word
            ? (pairWordStartCoordinates.X, pairWordStartCoordinates.Y + pairWord.WordStr.Length - 1)
            : (pairWordStartCoordinates.X + pairWord.WordStr.Length - 1, pairWordStartCoordinates.Y);

        if (pairWordStartCoordinates.X < 0 || pairWordStartCoordinates.Y < 0  || pairWordEndCoordinates.X < 0 
            || pairWordEndCoordinates.Y < 0)
        {
            return false;
        }

        List<(int X, int Y, char Letter)> wordLettersWithCoordinates = new List<(int X, int Y, char Letter)>();
        var pairWordLetters = pairWord.WordStr.ToCharArray();
        for (int i = 0; i < pairWordLetters.Length; i++)
        {
            if (currentUsedWord.WordDirection == WordDirection.Horizontal)
                wordLettersWithCoordinates.Add((pairWordStartCoordinates.X, pairWordStartCoordinates.Y+i, pairWordLetters[i]));
            else
                wordLettersWithCoordinates.Add((pairWordStartCoordinates.X + i, pairWordStartCoordinates.Y, pairWordLetters[i]));
        }
        foreach(var crossedLetterCoord in usedWords.Values.SelectMany(w => w.CrossedLetters))
        {
            if (wordLettersWithCoordinates.Any(l => l.X == crossedLetterCoord.X && l.Y == crossedLetterCoord.Y
                && l.Letter != crossedLetterCoord.Letter))
            {
                return false;
            }
        }

        return true;
    }
}
